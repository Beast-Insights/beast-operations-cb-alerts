# Database — the recon agent log table lives here.
# Option A: one connection string
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Option B: split vars (used if DATABASE_URL is unset)
PGHOST=db.beastinsights.com
PGPORT=5432
PGUSER=beastinsights_ro
PGPASSWORD=
PGDATABASE=postgres
# SSL: require (default) | disable | strict
PGSSL=require
